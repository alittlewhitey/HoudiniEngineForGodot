[gd_scene load_steps=5 format=4 uid="uid://cc3laxtlyi0og"]

[sub_resource type="GDScript" id="GDScript_4xowi"]
script/source = "@tool
extends Node3D
var _node: HEGNode
@export_tool_button(\"Test\")
var test := func():
	HEGSession.switchSession(HEGSession.InProcess)
	var asset = HEGSession.getSession().loadHDA(load(\"res://hda/hexagona_lite.hda\"))
	var operator = asset.ownedNodeOperators[0]
	var node = HEGNode.createNode(operator, operator) as HEGSopNode
	node.cook()
	_node = node
	if !await node.cookFinished:
		return
	print(node)
	print(operator)
	print(node.getType(), node.get_class())
	print(node.getGeometryCount())
	var mesh = (node.getGeometry(0) as HEGMesh).bakeAsMesh()
	print(mesh)
	$MeshInstance3D.mesh = mesh

@export_tool_button(\"Test2\")
var test2 := func():
	HEGSession.switchSession(HEGSession.InProcess)
	var asset = HEGSession.getSession().loadHDA(load(\"res://hda/TestCurve2.hda\"))
	for operator in asset.ownedNodeOperators:
		print(operator)
		var node = HEGNode.createNode(operator, operator)
		print(node)
		node.cook()
		if !await node.cookFinished:
			return
		for n2 in node.getChildList():
			print(n2)
			if(n2.cook()):
				await n2.cookFinished
				print(n2.getGeometryCount())
				print(n2.getGeometry(0))
				var curveArr = (n2.getGeometry(0) as HEGCurve).bakeAsCurve()
				print(curveArr)
				$Path3D.curve = curveArr[0]
			else:
				print(\"No such node\")

@export_tool_button(\"Test3\")
var test3 := func():
	HEGSession.switchSession(HEGSession.InProcess)
	var node = HEGSopNode.inputCurveNode(\"test_curve\",$Path3D.curve)
	node.cook()
	await node.cookFinished
	HEGSession.getSession().saveHIP(\"res://temp.hip\",false)

@export_tool_button(\"Test4\")
var test4 := func():
	HEGSession.switchSession(HEGSession.InProcess)
	var arr = HEGSession.getSession().loadHIP(load(\"res://temp.hip\"))
	for a in arr:
		print(a)
"

