[sub_resource type="GDScript" id="GDScript_4xowi"]
script/source = "@tool
extends Node3D
var _node: HENode
@export_tool_button(\"Test\")
var test := func():
	HESession.switchSession(HESession.InProcess)
	var asset = HESession.getSession().loadHDA(load(\"res://hda/0_he_sop_box.hda\"))
	var operator = asset.ownedNodeOperators[0]
	var node = HESession.getSession().createNode(operator, operator) as HESopNode
	node.cook()
	_node = node
	await node.cookFinished
	#while !node.isCookFinished():
		#await get_tree().create_timer(0.2).timeout
	print(node)
	print(operator)
	print(node.getType(), node.get_class())
	print(node.getGeometryCount())
	var mesh = (node.getGeometry(0) as HEMesh).bakeAsMesh()
	print(mesh)
	$MeshInstance3D.mesh = mesh

@export_tool_button(\"Test2\")
var test2 := func():
	HESession.getSession().deleteNode(_node)
	pass

@export_tool_button(\"Test3\")
var test3 := func():
	print_rich(\"[color=#909090]GDScript[/color]\");
	print_rich(\"[color=#888888]GDScript[/color]\");
	print_rich(\"[color=#969696]GDScript[/color]\");
"

