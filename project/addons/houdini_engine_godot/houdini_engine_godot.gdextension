[configuration]

entry_symbol = "init_library"
compatibility_minimum = 4.4

[libraries]

linux.debug.x86_64 = "bin/libhoudini_engine_godot.linux.debug.x86_64.so"
linux.release.x86_64 = "bin/libhoudini_engine_godot.linux.release.x86_64.so"
linux.debug.arm64 = "bin/libhoudini_engine_godot.linux.debug.arm64.so"
linux.release.arm64 = "bin/libhoudini_engine_godot.linux.release.arm64.so"
linux.debug.rv64 = "bin/libhoudini_engine_godot.linux.debug.rv64.so"
linux.release.rv64 = "bin/libhoudini_engine_godot.linux.release.rv64.so"
windows.debug.x86_64 = "bin/libhoudini_engine_godot.windows.debug.x86_64.dll"
windows.release.x86_64 = "bin/libhoudini_engine_godot.windows.release.x86_64.dll"
macos.debug = "bin/libhoudini_engine_godot.macos.debug.framework"
macos.release = "bin/libhoudini_engine_godot.macos.release.framework"
android.debug.arm64 = "bin/libhoudini_engine_godot.android.debug.arm64.so"
android.release.arm64 = "bin/libhoudini_engine_godot.android.release.arm64.so"
