[configuration]

entry_symbol = "init_library"
compatibility_minimum = 4.2

[libraries]
linux.debug.x86_64 = "bin/libHoudiniEngineForGodot.linux.debug.x86_64.so"
linux.release.x86_64 = "bin/libHoudiniEngineForGodot.linux.release.x86_64.so"
linux.debug.arm64 = "bin/libHoudiniEngineForGodot.linux.debug.arm64.so"
linux.release.arm64 = "bin/libHoudiniEngineForGodot.linux.release.arm64.so"
linux.debug.rv64 = "bin/libHoudiniEngineForGodot.linux.debug.rv64.so"
linux.release.rv64 = "bin/libHoudiniEngineForGodot.linux.release.rv64.so"
windows.debug.x86_64 = "bin/libHoudiniEngineForGodot.windows.debug.x86_64.dll"
windows.release.x86_64 = "bin/libHoudiniEngineForGodot.windows.release.x86_64.dll"
macos.debug.arm64 = "bin/libHoudiniEngineForGodot.macos.debug.arm64"
macos.release.arm64 = "bin/libHoudiniEngineForGodot.macos.release.arm64"
android.debug.arm64 = "bin/libHoudiniEngineForGodot.android.debug.arm64.so"
android.release.arm64 = "bin/libHoudiniEngineForGodot.android.release.arm64.so"
