[configuration]

entry_symbol = "init_library"
compatibility_minimum = 4.3

[libraries]
linux.x86_64 = "bin/libHoudiniEngineForGodot.linux.x86_64.so"
linux.arm64 = "bin/libHoudiniEngineForGodot.linux.arm64.so"
linux.rv64 = "bin/libHoudiniEngineForGodot.linux.rv64.so"
windows.x86_64 = "bin/libHoudiniEngineForGodot.windows.x86_64.dll"
macos.arm64 = "bin/libHoudiniEngineForGodot.macos.arm64.dylib"
android.arm64 = "bin/libHoudiniEngineForGodot.android.arm64.so"
